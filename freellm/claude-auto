#!/usr/bin/env bash
# claude-auto : lance Claude Code normalement, et bascule automatiquement sur
# les modèles gratuits de FreeLLMAPI quand ta limite Claude est atteinte.
#
#   claude [options...]          choix automatique (Claude, ou gratuit si limite atteinte)
#   claude --free [options...]   force les modèles gratuits
#   claude --claude [options...] force Claude, sans vérification
#
# Avant chaque session, une mini-requête (« Reply with OK », modèle Haiku) teste
# si ton compte Claude répond encore. Si la réponse est « limite atteinte »,
# Claude Code est relancé vers FreeLLMAPI au lieu des serveurs d'Anthropic.

set -uo pipefail

CONFIG="${CLAUDE_AUTO_CONFIG:-$HOME/.config/claude-auto/config}"
# shellcheck disable=SC1090
[ -f "$CONFIG" ] && . "$CONFIG"
FREELLMAPI_URL="${FREELLMAPI_URL:-http://localhost:3001}"
FREELLMAPI_DIR="${FREELLMAPI_DIR:-$HOME/freellmapi}"
PROBE_TIMEOUT="${CLAUDE_AUTO_PROBE_TIMEOUT:-60}"

# Inside a script the `claude` alias does not apply, so this finds the real CLI.
REAL_CLAUDE="${CLAUDE_BIN:-$(command -v claude || true)}"
if [ -z "$REAL_CLAUDE" ]; then
  echo "claude-auto : Claude Code est introuvable (installe-le : https://claude.com/claude-code)." >&2
  exit 127
fi

info() { printf '\033[2m%s\033[0m\n' "$*" >&2; }
warn() { printf '\033[1;33m%s\033[0m\n' "$*" >&2; }

with_timeout() {
  local secs=$1; shift
  "$@" &
  local pid=$!
  ( sleep "$secs"; kill "$pid" 2>/dev/null ) >/dev/null 2>&1 &
  local watcher=$!
  wait "$pid"
  local code=$?
  kill "$watcher" 2>/dev/null
  return $code
}

# Succeeds when Claude answers with a usage/rate limit error.
claude_limited() {
  local out code
  # Output goes to a file, not a pipe: a hung child could hold a pipe open past the timeout.
  out=$(mktemp "${TMPDIR:-/tmp}/claude-auto.XXXXXX") || return 1
  (cd "${TMPDIR:-/tmp}" && CLAUDE_CODE_MAX_RETRIES=0 with_timeout "$PROBE_TIMEOUT" "$REAL_CLAUDE" -p \
    --model haiku --tools "" --strict-mcp-config --setting-sources user \
    --no-session-persistence "Reply with OK" </dev/null >"$out" 2>&1)
  grep -qiE "limit reached|hit your( [a-z-]+)? limit|usage limit|rate.?limit|limit (resets|will reset)|credit balance is too low" "$out"
  code=$?
  rm -f "$out"
  return $code
}

freellmapi_up() {
  curl -fsS -m 3 "$FREELLMAPI_URL/api/ping" >/dev/null 2>&1
}

start_freellmapi() {
  freellmapi_up && return 0
  if [ -f "$FREELLMAPI_DIR/docker-compose.yml" ] && command -v docker >/dev/null 2>&1; then
    info "Démarrage de FreeLLMAPI…"
    (cd "$FREELLMAPI_DIR" && docker compose up -d >/dev/null 2>&1)
    for _ in $(seq 1 30); do freellmapi_up && return 0; sleep 1; done
  fi
  return 1
}

run_free() {
  if [ -z "${FREELLMAPI_API_KEY:-}" ]; then
    warn "claude-auto : aucune clé FreeLLMAPI configurée. Relance freellm/install.sh."
    exit 1
  fi
  if ! start_freellmapi; then
    warn "claude-auto : FreeLLMAPI ne répond pas sur $FREELLMAPI_URL."
    warn "Démarre-le (Docker : cd $FREELLMAPI_DIR && docker compose up -d, ou l'app de bureau) puis relance."
    exit 1
  fi
  # Same environment `npx freellmapi launch` sets, but it also forwards your arguments (-c, --resume…).
  unset ANTHROPIC_API_KEY
  export ANTHROPIC_BASE_URL="$FREELLMAPI_URL"
  export ANTHROPIC_AUTH_TOKEN="$FREELLMAPI_API_KEY"
  export CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1
  exec "$REAL_CLAUDE" "$@"
}

case "${1:-}" in
  --free) shift; warn "⚡ Modèles gratuits (FreeLLMAPI) — forcé avec --free"; run_free "$@" ;;
  --claude) shift; exec "$REAL_CLAUDE" "$@" ;;
  # Management subcommands never talk to the model: no probe needed.
  mcp|config|update|doctor|install|plugin|plugins|auth|setup-token|migrate-installer|-v|--version|-h|--help)
    exec "$REAL_CLAUDE" "$@" ;;
esac

info "Vérification de ta limite Claude…"
if claude_limited; then
  warn "⚡ Limite Claude atteinte — bascule sur les modèles gratuits (FreeLLMAPI)."
  run_free "$@"
fi
exec "$REAL_CLAUDE" "$@"
